# LEGACYBRIDGE console configuration. Copy to .env (never commit .env).
# HALDEN ERP connection (synthetic demo credentials of the simulated system).
LEGACY_BASE_URL=http://localhost:8090
LEGACY_LOGIN=svc_bridge
LEGACY_SECRET=halden-demo-secret
LEGACY_TIMEOUT_SEC=5
LEGACY_MAX_RETRIES=2
# Optional AI assistant (Mode B). Leave the key empty for the free deterministic Mode A.
LLM_MODEL=anthropic:claude-opus-5-5
LLM_ENABLE=
ANTHROPIC_API_KEY=
# Tests only.
LEGACYBRIDGE_TEST_ERP_URL=http://127.0.0.1:8090
